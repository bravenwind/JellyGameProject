*.dylib filter=lfs diff=lfs merge=lfs -text
*.ArtifactDB filter=lfs diff=lfs merge=lfs -text
*.resS filter=lfs diff=lfs merge=lfs -text

# .editorconfig 는 에디터에게 부탁하는 것이고, 이쪽은 git 이 직접 강제한다.
# 저장소에는 LF 로 넣고 꺼낼 때 CRLF 로 준다 — 누가 어떤 에디터로 열든
# 커밋되는 내용이 같아져서, 줄바꿈 때문에 diff 가 파일 전체로 부푸는 일이 없어진다.
*.cs text eol=crlf

# 유니티가 쓰는 YAML. 확장자만 보면 언제나 텍스트라 안전하다
*.meta   text eol=crlf
*.unity  text eol=crlf
*.prefab text eol=crlf

# 사람이 쓰는 문서
*.md text eol=crlf

# ★ *.asset 은 일부러 넣지 않는다
#   같은 확장자인데 전부 YAML 이 아니다 — 96개 중 15개(NavMesh, LightingData,
#   XRSettings)가 널 바이트가 든 바이너리다. text 로 묶으면 git 이 줄바꿈을
#   바꾸려다 그 파일들을 깨뜨린다.
#   확실히 바이너리인 것들만 손대지 못하게 막아두고, 나머지 .asset 은
#   지금처럼 건드리지 않은 채로 둔다.
*.asset -text
Assets/Scenes/**/NavMesh-*.asset -text
Assets/Scenes/**/LightingData.asset -text
